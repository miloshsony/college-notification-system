<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#f5f5f5">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Notification"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#6200EE"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Target Audience Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send To:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/target_audience_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_all_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All Users (Everyone)"
                android:checked="true"
                android:padding="12dp"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radio_students_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Students Only"
                android:padding="12dp"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radio_teaching_staff_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teaching Staff Only"
                android:padding="12dp"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radio_non_teaching_staff_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Non-Teaching Staff Only"
                android:padding="12dp"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Notification Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notification Title"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notification Message -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notification Message"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/notification_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="5"
                android:minHeight="120dp"
                android:gravity="top|start" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send Button -->
        <Button
            android:id="@+id/btn_send_notification"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SEND NOTIFICATION"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
